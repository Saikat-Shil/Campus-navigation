# ==============================================================
# Presidency University Campus Navigation — .gitignore
# ==============================================================

# ── Virtual environment ────────────────────────────────────────
.venv/
venv/
env/

# ── Environment / secrets (never commit credentials) ──────────
.env
.env.*
!.env.example

# ── Python cache ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Backup files (timestamped and .bak) ───────────────────────
*.bak
*.*.bak

# ── OS / editor artifacts ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/

# ── Local Flask / Werkzeug ────────────────────────────────────
instance/
*.log

# ── Build / distribution ──────────────────────────────────────
dist/
build/
*.egg-info/

# ==============================================================
# DO NOT ignore these — they must be committed:
#   requirements.txt
#   app.py
#   templates/
#   static/
#   data/campus_facilities.json
#   Procfile
#   .gitignore
# ==============================================================
